# App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# URL publik frontend (SPA) — dipakai iPaymu/Midtrans untuk redirect setelah bayar
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/wa_gateway

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_here_min_32_chars
JWT_REFRESH_EXPIRES_IN=30d

# Session Encryption
SESSION_SECRET_KEY=12345678901234567890123456789012

# Webhook
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_RETRIES=3

# Rate Limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# Message Queue
MESSAGE_DELAY_MIN_MS=1000
MESSAGE_DELAY_MAX_MS=3000
MESSAGE_MAX_RETRIES=3

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=16

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175

# Payment Gateway (ipaymu | midtrans)
PAYMENT_PROVIDER=ipaymu

# iPaymu — VA & API Key dari dashboard https://my.ipaymu.com
IPAYMU_VA=
IPAYMU_API_KEY=
IPAYMU_IS_PRODUCTION=false

# Midtrans (alternatif) — https://dashboard.midtrans.com
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# SMTP Email (leave empty to disable email sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Blastify <no-reply@yourdomain.com>
EMAIL_VERIFICATION_REQUIRED=false

# Cloudinary (media upload) — https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI Auto-Reply (gemini | openai)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AI_MAX_OUTPUT_TOKENS=300
AI_CONTEXT_MESSAGES=6

# Sentry error tracking — https://sentry.io (kosongkan untuk nonaktif)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
